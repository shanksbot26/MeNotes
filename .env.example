# ==========================================
# MeNotes Server Configuration
# ==========================================

# Port exposed on host machine (default: 3000)
PORT=3000

# Secret passphrase required to synchronize notes from client apps.
# Set this to a strong password and enter the same value in MeNotes app Settings.
SYNC_SECRET=akuiki26

# Path inside container for SQLite database storage (default: /app/data)
DATA_DIR=/app/data

# Environment mode
NODE_ENV=production

